{
  "name": "glass-app",
  "version": "1.0.0",
  "description": "AI Dubbing Studio - Desktop video dubbing application",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint src/",
    "test": "npm run lint && node tests/run-phase1-tests.js && node tests/run-phase2-tests.js && node tests/run-phase3-tests.js && node tests/test-defects-phase2.js && node tests/test-schema-migration.js && node tests/verify-phase3-improvements.js && node tests/test-phase4-packaging.js",
    "test:e2e": "node audit/run_e2e_audit.js",
    "audit": "node audit/run_audit.js",
    "screenshot:phase3": "electron tests/capture-phase3-screenshots.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aidubbingstudio.app",
    "productName": "AI Dubbing Studio PRO",
    "copyright": "Copyright © 2026 AI Dubbing Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "test-assets/sample_10s_project/**/*",
      "test-assets/sample_10s.mp4",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/sidecar",
        "to": "sidecar"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/ffprobe-static/**/*",
      "**/*.node",
      "**/node_modules/@napi-rs/canvas*/**/*",
      "src/renderer/assets/fonts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo/Dubber Studio Pro.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Dubbing Studio PRO",
      "uninstallDisplayName": "AI Dubbing Studio PRO",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "eslint": "^10.11.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "@napi-rs/canvas": "^0.1.53"
  }
}
